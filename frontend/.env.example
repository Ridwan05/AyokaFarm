# Copy to .env.local and fill in. Never commit real values — set them in Vercel → Settings →
# Environment Variables for deployments. Not used yet: the app still runs on mock data.

# Public (sent to the browser; safe because row-level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never prefix with NEXT_PUBLIC_. Only needed for admin jobs such as inviting staff.
SUPABASE_SECRET_KEY=
